APP_URL=http://localhost:3000
FLOW_ENV=sandbox
FLOW_API_KEY=REEMPLAZAR
FLOW_SECRET_KEY=REEMPLAZAR
# Obligatorio para pagos reales; no usar la base local en hosting efímero.
DATABASE_URL=postgresql://usuario:password@localhost:5432/caoz
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
## Optional: only for an empty local development database. Never enable this in Vercel.
SEED_DEFAULT_ADMIN=false
SEED_DEFAULT_ADMIN_EMAIL=
SEED_DEFAULT_ADMIN_PASSWORD=
SEED_DEFAULT_ADMIN_USERNAME=admin
